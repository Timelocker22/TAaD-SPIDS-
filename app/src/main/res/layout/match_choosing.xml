<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:padding="24dp">

    <!-- Кастомная круглая кнопка назад -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/arrow"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:background="@drawable/bg_button_back"
        app:layout_constraintStart_toStartOf="parent"
         />

    <!-- Заголовок экрана (центрирован по экрану, а кнопка привязана к его боку) -->
    <TextView
        android:id="@+id/tv_settings_title"
        style="@style/Typography.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:text="Настройки матча"
        android:textColor="@color/text_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <com.google.android.material.button.MaterialButton
        android:shadowColor="@color/neutral_black"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="1"
        android:id="@+id/squats"
        style="@style/Typography.Heading"
        android:layout_width="@dimen/width_primary"
        android:layout_height="@dimen/height_primary"
        android:layout_marginTop="160dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="Приседания"
        android:textColor="@color/text"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_settings_title" />
    <com.google.android.material.button.MaterialButton
        android:shadowColor="@color/neutral_black"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="1"
        android:id="@+id/push_ups"
        style="@style/Typography.Heading"
        android:layout_width="@dimen/width_primary"
        android:layout_height="@dimen/height_primary"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="Отжимания"
        android:textColor="@color/text"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/squats" />

</androidx.constraintlayout.widget.ConstraintLayout>
