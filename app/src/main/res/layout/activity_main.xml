<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/surface"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/textViewTitle"
        style="@style/Typography.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="Training App(And Duels)"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/company_name"
        style="@style/Typography.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="710dp"
        android:text="@spidsters"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:shadowColor="@color/neutral_black"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="1"
        android:id="@+id/btn_fast_match"
        style="@style/Typography.Heading"
        android:layout_width="@dimen/width_primary"
        android:layout_height="@dimen/height_primary"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="Быстрый матч"
        android:textColor="@color/text"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_friend_match"
        style="@style/Typography.Heading"
        android:layout_width="@dimen/width_primary"
        android:layout_height="@dimen/height_primary"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:shadowColor="@color/neutral_black"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="1"
        android:text="Матч с другом"
        android:textColor="@color/text"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_fast_match" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_leaderboard"
        style="@style/Typography.Heading"
        android:layout_width="@dimen/width_primary"
        android:layout_height="@dimen/height_primary"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:shadowColor="@color/neutral_black"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="1"
        android:text="Таблица лидеров"
        android:textColor="@color/text"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_friend_match" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings"
        style="@style/Typography.Heading"
        android:layout_width="@dimen/width_primary"
        android:layout_height="@dimen/height_primary"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:shadowColor="@color/neutral_black"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="1"
        android:text="Настройки"
        android:textColor="@color/text"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_leaderboard" />


</androidx.constraintlayout.widget.ConstraintLayout>